ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to claude-sonnet-5 if unset.
# Pick the exact model string for the tier you want (Haiku's ID includes
# a date suffix — copy it exactly, "claude-haiku-4-5" alone will not work):
#   Haiku (cheapest, $1/$5 per MTok)   -> claude-haiku-4-5-20251001
#   Sonnet (recommended default, $2-3/$10-15 per MTok) -> claude-sonnet-5
#   Opus (highest accuracy, $5/$25 per MTok) -> claude-opus-4-8
CLAUDE_MODEL=claude-sonnet-5

# Neon connection string (use the pooled connection string from the Neon
# dashboard; replace sslmode=require with verify-full for better security)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# Cloudflare R2 — create a bucket in the Cloudflare dashboard (R2 > Create
# bucket), then create an API token scoped to that bucket
# (R2 > Manage API Tokens > Create API Token > Object Read & Write).
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=invoices

# Extraction review policy — controls what triggers needs_review flag.
# If false, these conditions won't automatically flag the invoice for review.
# Values: true or false (default: true for safety)
NEEDS_REVIEW_IF_INFERRED_BILL_TO=false
NEEDS_REVIEW_IF_ILLEGIBLE_BILL_TO=false
NEEDS_REVIEW_IF_CALCULATED_DUE_DATE=false
